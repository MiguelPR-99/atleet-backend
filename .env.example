# Environment — Atleet Backend
# Copia este archivo como .env y ajusta los valores

# ── Base de Datos ──────────────────────────────────────────────
DATABASE_URL="postgresql://atleet:atleet_secret@localhost:5432/atleet_db?schema=public"

# ── Docker Compose ────────────────────────────────────────────
POSTGRES_USER=atleet
POSTGRES_PASSWORD=atleet_secret
POSTGRES_DB=atleet_db
PGADMIN_EMAIL=admin@atleet.mx
PGADMIN_PASSWORD=admin123

# ── Servidor ─────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── USDA FoodData Central API ────────────────────────────────
# Obtén tu API Key gratuita en: https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=DEMO_KEY
USDA_BASE_URL=https://api.nal.usda.gov/fdc/v1
